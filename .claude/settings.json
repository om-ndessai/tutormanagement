{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",

      "Bash(npm run typecheck*)",
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(npm run db:rebuild)",
      "Bash(npm run db:seed)",
      "Bash(npm run db:reset*)",
      "Bash(npm run db:studio*)",
      "Bash(npm run db:seed:generate*)",
      "Bash(npm run e2e:test*)",
      "Bash(npm run e2e:report*)",
      "Bash(npm run ui:add*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm ls*)",
      "Bash(npx tsc*)",
      "Bash(npx playwright test*)",
      "Bash(npx wrangler d1 execute * --local*)",
      "Bash(npx wrangler dev*)",
      "Bash(npx wrangler whoami*)",
      "Bash(node *)",
      "Bash(source *)",
      "Bash(export *)",
      "Bash(curl *)",
      "Bash(python3 *)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore*)",
      "Bash(git add*)",
      "Bash(git commit*)",

      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(sed -n *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(sort *)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(sleep *)"
    ],
    "ask": [
      "Bash(npx wrangler deploy*)",
      "Bash(npm run deploy*)",
      "Bash(npm run e2e)",
      "Bash(bash scripts/e2e.sh*)",
      "Bash(npx wrangler d1 execute * --remote*)",
      "Bash(npx wrangler d1 export*)",
      "Bash(npx wrangler secret*)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(rm *)"
    ],
    "deny": [
      "Bash(npm run db:rebuild:remote*)",
      "Bash(npm run db:migrate:remote*)"
    ]
  }
}
