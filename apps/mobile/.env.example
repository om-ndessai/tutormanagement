# Build-time configuration for the mobile app (read by app.config.ts).
# Copy to .env.local (gitignored) and fill in; never commit real values in a .env file.
# See docs/mobile/google-sign-in.md and docs/google-oauth-setup.md ("The mobile app").

# Which build: development (default), e2e or production.
# APP_VARIANT=development

# iOS OAuth client ID for the development build (bundle id com.tutorportal.app.dev).
# Its reversed form becomes the app's URL scheme. Leave empty and the Google button is hidden
# on iOS (the build still succeeds; the developer sign-in still works on a server with sign-in off).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID_DEV=

# iOS OAuth client ID for the production build (bundle id com.tutorportal.app).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# iOS OAuth client ID for the personal build (bundle id com.tutorportal.app.personal): the
# production app signed by a free Apple ID for your own iPhones (docs/mobile/real-devices.md).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID_PERSONAL=

# The Apple team that signs device builds -- your Personal Team ID for the personal build
# (Xcode > Settings > Accounts, or `security find-identity -v -p codesigning`).
# APPLE_TEAM_ID=

# The portal's web OAuth client ID. The app reads it from the server's /api/auth/config at
# runtime; this is only the fallback. Defaults to the portal's public web client.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=866980945062-aoh0gotj6fld07cd9gtkeo7p0hdu9gsa.apps.googleusercontent.com

# The server the production build talks to: the multi-organization address, never tmi-portal.
# EXPO_PUBLIC_PRODUCTION_API_URL=https://tutoring.om-ndessai.workers.dev
