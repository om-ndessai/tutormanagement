{
	"$schema": "node_modules/wrangler/config-schema.json",
	/**
	 * FOUR Workers, ONE code version, TWO databases (2026-10-06):
	 *
	 *   Worker            database          sign-in  lands in   lesson sweep
	 *   tmi-portal        tutoring-db       on       tmi        no
	 *   tutoring          tutoring-db       on       (choose)   yes
	 *   tmi-portal-test   tutoring-test-db  OFF      chmi       no
	 *   tutoring-test     tutoring-test-db  OFF      (choose)   yes
	 *
	 * The two of each pair differ only in their address, which organization a
	 * visitor lands in (DEFAULT_ORGANIZATION), and which of them runs the cron.
	 * tmi-portal-db and tmi-portal-test-db are no longer bound to anything; the
	 * institute's records live in tutoring-db as the organization `tmi`
	 * (docs/migration-tmi.md).
	 *
	 * Deploy with `npm run deploy:test` (both test Workers) and `npm run deploy`
	 * (both production Workers) -- never one of a pair alone, or the two would
	 * serve different code against one database.
	 *
	 * The top level is tmi-portal. Named environments do NOT inherit `assets`,
	 * `d1_databases`, `vars` or `triggers`, so each restates all four: no Worker
	 * can reach a database by inheriting someone else's binding.
	 */
	"name": "tmi-portal",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-19",
	// The Worker both serves the API and hosts the built React SPA, so the whole
	// portal is a single `wrangler deploy` on the Workers free plan.
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Without this, a request to /api/users would be answered by the SPA
		// fallback instead of reaching the Worker.
		"run_worker_first": [
			"/api/*"
		]
	},
	// No sweep here: `tutoring` runs it against the same database. Two Workers
	// sweeping one database could both close the same overrunning lesson and
	// bill it twice.
	"triggers": {
		"crons": []
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tutoring-db",
			"database_id": "b76a2704-491f-47a1-88b6-86b047cfc56d"
		}
	],
	"vars": {
		// These are the values a DEPLOY ships with, so the safe setting wins here
		// and local development opts out. `.dev.vars` overrides anything in this
		// block during `wrangler dev`, which is where ENVIRONMENT=development is
		// set. Getting this backwards silently shipped dev-mode CORS to
		// production once already.
		"ENVIRONMENT": "production",

		// Google OAuth web client id. Not a secret -- it is sent to the browser.
		// See docs/google-oauth-setup.md for how to create one.
		"GOOGLE_CLIENT_ID": "866980945062-aoh0gotj6fld07cd9gtkeo7p0hdu9gsa.apps.googleusercontent.com",

		// Master switch for authentication. Google sign-in is the only way in.
		// Only the exact string "false" disables auth; any other value leaves it
		// on, so a typo cannot quietly open up the API. "false" makes the
		// deployment PUBLIC, so it belongs to the test Workers and nowhere else.
		"AUTH_ENABLED": "true",

		// Who the API runs as while AUTH_ENABLED is "false". Unused here.
		"DEV_USER_EMAIL": "",

		// While the platform has no platform admin, these addresses become one
		// on signing in. Only the escape hatch: tutoring-db has one.
		"BOOTSTRAP_ADMIN_EMAILS": "ndessai@gmail.com",

		// The organization this address is FOR: its sign-in page wears it, and a
		// member of it lands in it without choosing. Membership is still checked
		// on every request -- this picks, it never grants.
		"DEFAULT_ORGANIZATION": "tmi"
	},
	"observability": {
		"enabled": true
	},

	"env": {
		/**
		 * The open test Worker at the institute's test address, with the same
		 * code as everything else. Sign-in is OFF (a visitor walks in as Priya,
		 * in the seeded organization `chmi`). It shares tutoring-test-db with
		 * tutoring-test, where the end-to-end suite runs; it is no longer tested
		 * itself (2026-10-06).
		 */
		"test": {
			"assets": {
				"directory": "../web/dist",
				"binding": "ASSETS",
				"not_found_handling": "single-page-application",
				"run_worker_first": [
					"/api/*"
				]
			},
			// tutoring-test sweeps this database.
			"triggers": {
				"crons": []
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "tutoring-test-db",
					"database_id": "7bba8b52-e104-45f6-9632-d88ce3abadc2"
				}
			],
			"vars": {
				// Relaxes the cookie Secure flag and CORS, as for every test Worker.
				"ENVIRONMENT": "development",
				// Sign-in stays configured so turning it back on is one value.
				"GOOGLE_CLIENT_ID": "866980945062-aoh0gotj6fld07cd9gtkeo7p0hdu9gsa.apps.googleusercontent.com",
				"AUTH_ENABLED": "false",
				// Named rather than left to the fallback, so every visitor sees the
				// same portal: a seeded admin of `chmi`.
				"DEV_USER_EMAIL": "priya.raghavan@gmail.com",
				"BOOTSTRAP_ADMIN_EMAILS": "ndessai@gmail.com",
				"DEFAULT_ORGANIZATION": "chmi"
			},
			"observability": {
				"enabled": true
			}
		},

		/** The tutoring platform: sign-in on, every organization, one address. */
		"tutoring": {
			"name": "tutoring",
			"assets": {
				"directory": "../web/dist",
				"binding": "ASSETS",
				"not_found_handling": "single-page-application",
				"run_worker_first": [
					"/api/*"
				]
			},
			// The ONE sweep of tutoring-db. Ends lessons whose timer was left
			// running past the limit; reading the live sessions in the portal does
			// the same, so this is the path that matters overnight and at weekends.
			"triggers": {
				"crons": [
					"*/15 * * * *"
				]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "tutoring-db",
					"database_id": "b76a2704-491f-47a1-88b6-86b047cfc56d"
				}
			],
			"vars": {
				"ENVIRONMENT": "production",
				// The same OAuth client; this origin is authorised on it too.
				"GOOGLE_CLIENT_ID": "866980945062-aoh0gotj6fld07cd9gtkeo7p0hdu9gsa.apps.googleusercontent.com",
				"AUTH_ENABLED": "true",
				"DEV_USER_EMAIL": "",
				"BOOTSTRAP_ADMIN_EMAILS": "ndessai@gmail.com",
				// No organization of its own: the sign-in page wears the last one
				// this browser used, else the neutral platform brand.
				"DEFAULT_ORGANIZATION": ""
			},
			"observability": {
				"enabled": true
			}
		},

		/**
		 * Where the end-to-end suite runs: `npm run e2e` deploys both test Workers,
		 * rebuilds tutoring-test-db from the schema and the seed, and tests here.
		 */
		"tutoring-test": {
			"name": "tutoring-test",
			"assets": {
				"directory": "../web/dist",
				"binding": "ASSETS",
				"not_found_handling": "single-page-application",
				"run_worker_first": [
					"/api/*"
				]
			},
			// The ONE sweep of tutoring-test-db.
			"triggers": {
				"crons": [
					"*/15 * * * *"
				]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "tutoring-test-db",
					"database_id": "7bba8b52-e104-45f6-9632-d88ce3abadc2"
				}
			],
			"vars": {
				"ENVIRONMENT": "development",
				"GOOGLE_CLIENT_ID": "866980945062-aoh0gotj6fld07cd9gtkeo7p0hdu9gsa.apps.googleusercontent.com",
				// Sign-in OFF: the suite names who it acts as with X-Dev-User.
				"AUTH_ENABLED": "false",
				"DEV_USER_EMAIL": "",
				"BOOTSTRAP_ADMIN_EMAILS": "ndessai@gmail.com",
				"DEFAULT_ORGANIZATION": ""
			},
			"observability": {
				"enabled": true
			}
		}
	}
}
