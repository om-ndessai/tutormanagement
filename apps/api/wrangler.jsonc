{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tmi-portal",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-19",
	// The Worker both serves the API and hosts the built React SPA, so the whole
	// portal is a single `wrangler deploy` on the Workers free plan.
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Without this, a request to /api/users would be answered by the SPA
		// fallback instead of reaching the Worker.
		"run_worker_first": [
			"/api/*"
		]
	},
	// Ends lessons whose timer was left running past the limit on the tutor's and
	// the student's profiles. Reading the live sessions in the portal does the
	// same sweep, so this is the path that matters when nobody is looking --
	// overnight, and at weekends.
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tmi-portal-db",
			"database_id": "587b5622-15bf-4fbb-9a3f-873bee7a67c5"
		}
	],
	"vars": {
		// These are the values a DEPLOY ships with, so the safe setting wins here
		// and local development opts out. `.dev.vars` overrides anything in this
		// block during `wrangler dev`, which is where ENVIRONMENT=development is
		// set. Getting this backwards silently shipped dev-mode CORS to
		// production once already.
		"ENVIRONMENT": "production",

		// Google OAuth web client id. Not a secret -- it is sent to the browser.
		// See docs/google-oauth-setup.md for how to create one.
		"GOOGLE_CLIENT_ID": "866980945062-aoh0gotj6fld07cd9gtkeo7p0hdu9gsa.apps.googleusercontent.com",

		// Master switch for authentication. Google sign-in is the only way in.
		//
		// Setting this to "false" makes every API route run as DEV_USER_EMAIL
		// (or, failing that, the first admin) and lets the SPA skip the login
		// screen, which is useful while building a phase. It also makes the
		// deployment PUBLIC to anyone with the URL, so it belongs in local
		// development, not in a deploy.
		//
		// Only the exact string "false" disables auth; any other value leaves
		// it on, so a typo cannot quietly open up the API.
		"AUTH_ENABLED": "true",

		// Who the API runs as while AUTH_ENABLED is "false". When empty, falls
		// back to the first admin, then to any user, and finally creates a
		// placeholder admin -- so an empty directory can never take the portal
		// down. Note that a non-admin here means writes return 403.
		"DEV_USER_EMAIL": "",

		// Chicken-and-egg escape hatch: while the users table contains no admin,
		// these comma-separated Google accounts may sign in and are created as
		// admins. Ignored the moment one admin exists.
		"BOOTSTRAP_ADMIN_EMAILS": "ndessai@gmail.com",

		// Which identity the portal wears. The institute's own, here and always:
		// the demo brand belongs to the test deployment and nowhere else.
		"BRAND": "institute"
	},
	"observability": {
		"enabled": true
	},

	/**
	 * Throwaway deployment for the end-to-end suite: `wrangler deploy --env test`
	 * publishes it as `tmi-portal-test` with its own D1 database.
	 *
	 * Named environments do NOT inherit `assets`, `d1_databases` or `vars`, so
	 * everything is restated here. That is the point: this environment must not
	 * be able to reach the production database by inheriting its binding.
	 *
	 * Authentication is permanently OFF here, which is what lets the suite act
	 * as each kind of user. The data is seeded fiction, and this Worker is never
	 * where real records live.
	 */
	"env": {
		"test": {
			"assets": {
				"directory": "../web/dist",
				"binding": "ASSETS",
				"not_found_handling": "single-page-application",
				"run_worker_first": [
					"/api/*"
				]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "tmi-portal-test-db",
					"database_id": "c175924e-1126-4a0a-ac8c-878806c3296b"
				}
			],
			"vars": {
				// Relaxes the cookie Secure flag and CORS, matching how the suite
				// may drive it from a local origin.
				"ENVIRONMENT": "development",

				// This deployment is the DEMO as well as the test target, and it
				// is open: anyone with the link walks straight in, because the
				// point is to be looked at. Everything in its database is seeded
				// fiction.
				//
				// Sign-in stays configured so putting it back is one value:
				// "true" here restores Google sign-in, and the origin is already
				// an authorised one on the OAuth client. See
				// docs/google-oauth-setup.md.
				"GOOGLE_CLIENT_ID": "866980945062-aoh0gotj6fld07cd9gtkeo7p0hdu9gsa.apps.googleusercontent.com",
				"AUTH_ENABLED": "false",

				// Who a visitor is. Named rather than left to the fallback --
				// which takes the first admin it finds -- so every visitor sees
				// the same portal, and sees it as a seeded person rather than as
				// whoever happens to sort first in the directory.
				"DEV_USER_EMAIL": "priya.raghavan@gmail.com",

				// Unused while sign-in is off: the escape hatch is a sign-in
				// path. Kept for when it goes back on.
				"BOOTSTRAP_ADMIN_EMAILS": "om.ndessai@gmail.com",

				// Its own name, mark and palette. Nothing of the institute's
				// identity appears in a competition.
				"BRAND": "chapel_hill"
			},
			"observability": {
				"enabled": true
			}
		},

		/**
		 * The TUTORING pipeline: where the multi-organization portal
		 * (docs/multi-organization.md) is built and run, so that the institute's
		 * production above -- which real families use every day -- is never
		 * disturbed by it. Two deployments, each with its own database:
		 *
		 *   tutoring       Google sign-in ON; becomes the multi-organization
		 *                  platform's production. `npm run deploy:tutoring`.
		 *   tutoring-test  sign-in OFF, for driving and testing it.
		 *                  `npm run deploy:tutoring-test`.
		 *
		 * As with `test`, everything is restated: named environments do not
		 * inherit `assets`, `d1_databases` or `vars`, and neither of these may
		 * ever reach the institute's database by inheriting its binding.
		 *
		 * Both databases start EMPTY -- no tables. Their first schema is the one
		 * with organization support, so `db/schema.sql` is deliberately not
		 * applied to them. Until it is, every data route answers with an error,
		 * and the cron is switched off (an empty list) so the lesson sweep does
		 * not fail every fifteen minutes. Put the crons back with the schema.
		 */
		"tutoring": {
			"name": "tutoring",
			"assets": {
				"directory": "../web/dist",
				"binding": "ASSETS",
				"not_found_handling": "single-page-application",
				"run_worker_first": [
					"/api/*"
				]
			},
			"triggers": {
				"crons": []
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "tutoring-db",
					"database_id": "b76a2704-491f-47a1-88b6-86b047cfc56d"
				}
			],
			"vars": {
				// Production values, as at the top of this file: secure cookies
				// and same-origin CORS.
				"ENVIRONMENT": "production",

				// The same OAuth client as the institute's. Its origin,
				// https://tutoring.om-ndessai.workers.dev, has to be an authorised
				// JavaScript origin on it -- see docs/google-oauth-setup.md.
				"GOOGLE_CLIENT_ID": "866980945062-aoh0gotj6fld07cd9gtkeo7p0hdu9gsa.apps.googleusercontent.com",
				"AUTH_ENABLED": "true",
				"DEV_USER_EMAIL": "",
				"BOOTSTRAP_ADMIN_EMAILS": "ndessai@gmail.com",

				// The neutral platform identity: not the institute's, not the
				// demo's. Each organization's own look arrives with Phase 30.
				"BRAND": "platform"
			},
			"observability": {
				"enabled": true
			}
		},

		"tutoring-test": {
			"name": "tutoring-test",
			"assets": {
				"directory": "../web/dist",
				"binding": "ASSETS",
				"not_found_handling": "single-page-application",
				"run_worker_first": [
					"/api/*"
				]
			},
			"triggers": {
				"crons": []
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "tutoring-test-db",
					"database_id": "7bba8b52-e104-45f6-9632-d88ce3abadc2"
				}
			],
			"vars": {
				// Relaxes the cookie Secure flag and CORS, as for `test`.
				"ENVIRONMENT": "development",

				"GOOGLE_CLIENT_ID": "866980945062-aoh0gotj6fld07cd9gtkeo7p0hdu9gsa.apps.googleusercontent.com",

				// Sign-in OFF: whoever opens it runs as DEV_USER_EMAIL, or the
				// fallback chain when that is empty. Fiction only, never real
				// records.
				"AUTH_ENABLED": "false",
				"DEV_USER_EMAIL": "",
				"BOOTSTRAP_ADMIN_EMAILS": "ndessai@gmail.com",

				"BRAND": "platform"
			},
			"observability": {
				"enabled": true
			}
		}
	}
}
